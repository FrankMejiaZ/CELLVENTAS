# ==============================================================
# CONFIGURACIÓN DE PRODUCCIÓN - CELLVENTAS (VT VALETEC)
# ==============================================================
NODE_ENV=production
PORT=8092
BACKEND_PORT=8092
FRONTEND_PORT=80

# Seguridad JWT (Generar una clave secreta larga y aleatoria para producción)
JWT_SECRET=reemplazar_por_clave_secreta_jwt_segura_de_produccion_2026

# Credenciales de Base de Datos PostgreSQL
POSTGRES_USER=valetec
POSTGRES_PASSWORD=reemplazar_por_password_seguro
POSTGRES_DB=cellventas_db
POSTGRES_PORT_HOST=5434

# Almacenamiento de Datos:
# En servidores Linux dejar vacío o comentado para usar el volumen nombrado Docker anti-errores de permisos.
# Para desarrollo local con carpeta bind mount en host, descomentar la siguiente línea:
# DB_STORAGE=./postgres-data
