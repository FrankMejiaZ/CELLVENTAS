# Configuración del Servidor CELLVENTAS - VT VALETEC
PORT=8092
NODE_ENV=development
JWT_SECRET=reemplazar_por_clave_secreta_jwt_segura

# Configuración de Base de Datos PostgreSQL (Opcional en local si se usa SQLite)
# Descomentar POSTGRES_HOST para activar el motor PostgreSQL
# POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=valetec
POSTGRES_PASSWORD=reemplazar_por_password_seguro
POSTGRES_DB=cellventas_db
