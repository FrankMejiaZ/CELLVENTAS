# Variables de entorno para CELLVENTAS - Sistema POS & Matriz de Compatibilidades

# Puerto del Backend Node.js / Express
BACKEND_PORT=8092

# Puerto del Frontend Nginx Web Server
FRONTEND_PORT=3006

# Puerto de PostgreSQL expuesto al Host
POSTGRES_HOST_PORT=5434

# Entorno de ejecucion (production / development)
NODE_ENV=production

# Base de Datos PostgreSQL
POSTGRES_HOST=cellventas-db
POSTGRES_PORT=5432
POSTGRES_USER=cellventas_user
POSTGRES_PASSWORD=cellventas_secure_pass
POSTGRES_DB=cellventas_db

# Clave Secreta JWT para Autenticacion
JWT_SECRET=cellventas_jwt_super_secret_key_2026
